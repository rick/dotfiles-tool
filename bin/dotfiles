#!/usr/bin/env bash
#
# dotfiles -- link config repos into $HOME with GNU stow, filling in secrets
#             from 1Password templates along the way.
#
# This program carries no configuration of its own. It reads a list of config
# repos from ~/.config/dotfiles/config, and each repo describes itself in a
# dotfiles.conf at its root. See README.md.
#
# Written for bash 3.2 so it runs against /bin/bash on stock macOS.

set -euo pipefail

PROGRAM="${0##*/}"
VERSION="0.2.0"

: "${XDG_CONFIG_HOME:=$HOME/.config}"
: "${XDG_DATA_HOME:=$HOME/.local/share}"

CONFIG_FILE="${DOTFILES_CONFIG:-$XDG_CONFIG_HOME/dotfiles/config}"
STATE_DIR="${DOTFILES_STATE:-$XDG_DATA_HOME/dotfiles}"
# Not hostname -s: with HostName unset it follows reverse DNS, which a VPN can answer.
if [ "$(uname)" = "Darwin" ]; then
  HOST="$(scutil --get ComputerName 2>/dev/null || true)"
  [ -n "$HOST" ] || HOST="$(hostname -s)"
else
  HOST="$(hostname -s)"
fi

DRY_RUN=0
ADOPT=0
VERBOSE=0
TMPDIRS=""
ONLY_REPO=""

# A callee returns this to say "handled, stop iterating".
REPO_STOP=10

if [ -t 0 ] && [ -t 1 ]; then INTERACTIVE=1; else INTERACTIVE=0; fi

# ---------------------------------------------------------------- output ----

if [ -t 1 ]; then
  C_RESET=$'\033[0m'; C_BOLD=$'\033[1m'; C_DIM=$'\033[2m'
  C_RED=$'\033[31m'; C_GREEN=$'\033[32m'; C_YELLOW=$'\033[33m'
else
  C_RESET=""; C_BOLD=""; C_DIM=""; C_RED=""; C_GREEN=""; C_YELLOW=""
fi

info()  { printf '%s==>%s %s\n' "$C_GREEN" "$C_RESET" "$*"; }
step()  { printf '  %s->%s %s\n' "$C_DIM" "$C_RESET" "$*"; }
warn()  { printf '%swarning:%s %s\n' "$C_YELLOW" "$C_RESET" "$*" >&2; }
die()   { printf '%serror:%s %s\n' "$C_RED" "$C_RESET" "$*" >&2; exit 1; }
debug() { [ "$VERBOSE" -eq 1 ] && printf '     %s%s%s\n' "$C_DIM" "$*" "$C_RESET" || true; }
repo_header() { printf '%s%s%s\n' "$C_BOLD" "$REPO_ID" "$C_RESET"; }

cleanup() {
  local d
  for d in $TMPDIRS; do
    [ -n "$d" ] && [ -d "$d" ] && rm -rf "$d"
  done
}
trap cleanup EXIT

need_cmd() {
  command -v "$1" >/dev/null 2>&1 || die "$1 is not installed. Run: $PROGRAM doctor --install"
}

# ------------------------------------------------------------ repo config ----

# Emit one config repo path per line. DOTFILES_REPOS (colon-separated)
# overrides the config file, which is handy for testing.
repo_list() {
  if [ -n "${DOTFILES_REPOS:-}" ]; then
    printf '%s' "$DOTFILES_REPOS" | tr ':' '\n'
    return 0
  fi

  [ -f "$CONFIG_FILE" ] || die "no config repos configured; expected $CONFIG_FILE
Create it with one config repo path per line, e.g.:

    mkdir -p $(dirname "$CONFIG_FILE")
    echo ~/git/dotfiles-work > $CONFIG_FILE"

  sed -e 's/[[:space:]]*#.*$//' -e 's/[[:space:]]*$//' "$CONFIG_FILE" |
    while IFS= read -r line; do
      [ -n "$line" ] || continue
      case "$line" in
        '~/'*) line="$HOME/${line#\~/}" ;;
      esac
      printf '%s\n' "$line"
    done
}

# Load one repo's dotfiles.conf, resetting every setting to its default first
# so nothing leaks between repos. Sets the REPO_* globals used by the commands.
load_repo() {
  REPO="$1"
  [ -d "$REPO" ] || die "config repo does not exist: $REPO"

  REPO_ID="$(basename "$REPO")"
  PACKAGES=()
  TEMPLATES=()
  DEPENDENCIES=()
  OP_VAULT=""
  OP_ACCOUNT=""
  PACKAGES_DIR="packages"
  TEMPLATES_DIR="templates"
  MIGRATIONS_DIR="migrations"
  SECRETS_PACKAGE="private"
  TARGET="$HOME"

  if [ -f "$REPO/dotfiles.conf" ]; then
    # dotfiles.conf is sourced, so a repo can branch on $HOST, $(uname), etc.
    # shellcheck disable=SC1090,SC1091
    . "$REPO/dotfiles.conf"
  else
    warn "$REPO has no dotfiles.conf; using defaults"
  fi

  PACKAGES_PATH="$REPO/$PACKAGES_DIR"
  TEMPLATES_PATH="$REPO/$TEMPLATES_DIR"
  SECRETS_PATH="$STATE_DIR/$REPO_ID"
  MIGRATIONS_PATH="$REPO/$MIGRATIONS_DIR"
  INSTALLED_MARKER="$STATE_DIR/$REPO_ID/installed"
  # Sibling of the secrets package, which secrets_repo rsyncs --delete into.
  MIGRATIONS_STATE="$STATE_DIR/$REPO_ID/migrations.applied"

  # An unset PACKAGES means "everything under packages/".
  if [ ${#PACKAGES[@]} -eq 0 ] && [ -d "$PACKAGES_PATH" ]; then
    local d
    for d in "$PACKAGES_PATH"/*/; do
      [ -d "$d" ] || continue
      d="${d%/}"
      PACKAGES[${#PACKAGES[@]}]="${d##*/}"
    done
  fi
}

# Run a function once per configured repo, with that repo's config loaded and
# any extra arguments passed through. --repo narrows the set. A callee that
# returns REPO_STOP ends the loop; any other failure propagates.
for_each_repo() {
  local fn="$1"
  shift
  local repo found=0 rc repos
  repos="$(repo_list)"

  while IFS= read -r repo; do
    [ -n "$repo" ] || continue
    if [ -n "$ONLY_REPO" ] && [ "$(basename "$repo")" != "$ONLY_REPO" ]; then
      continue
    fi
    found=1
    load_repo "$repo"
    rc=0
    "$fn" "$@" || rc=$?
    if [ "$rc" -ne 0 ]; then
      if [ "$rc" -eq "$REPO_STOP" ]; then
        return 0
      fi
      return "$rc"
    fi
  done <<EOF
$repos
EOF

  if [ "$found" -eq 0 ]; then
    [ -z "$ONLY_REPO" ] || die "no configured repo named '$ONLY_REPO'"
    die "no config repos configured in $CONFIG_FILE"
  fi
}

# ---------------------------------------------------------- dependencies ----

# A DEPENDENCIES entry is "command [package] [cask]" -- the command to look for,
# the brew package providing it if the names differ, and the word "cask" if it
# is one. The engine has no built-in list; these come from the config repo, so
# a machine only installs what its own dotfiles actually need.
parse_dep() {
  # shellcheck disable=SC2086
  set -- $1
  DEP_CMD="$1"
  DEP_PKG="${2:-$1}"
  DEP_KIND="${3:-formula}"
}

# A dependency counts as present if its command is on PATH or -- for GUI casks
# that ship no binary at all -- if brew already has the cask. Without the
# second test such a cask looks permanently missing and gets reinstalled on
# every run.
dep_present() {
  if command -v "$DEP_CMD" >/dev/null 2>&1; then
    return 0
  fi
  if [ "$DEP_KIND" = cask ] && command -v brew >/dev/null 2>&1; then
    brew list --cask "$DEP_PKG" >/dev/null 2>&1 && return 0
  fi
  return 1
}

brew_install_dep() {
  if dep_present; then
    return 0
  fi

  if ! command -v brew >/dev/null 2>&1; then
    warn "$DEP_CMD is missing and brew is not available to install $DEP_PKG"
    return 1
  fi

  if [ "$DRY_RUN" -eq 1 ]; then
    step "would install $DEP_PKG"
    return 0
  fi

  step "installing $DEP_PKG"
  if [ "$DEP_KIND" = cask ]; then
    brew install --cask "$DEP_PKG"
  else
    brew install "$DEP_PKG"
  fi
}

ensure_deps_repo() {
  if [ ${#DEPENDENCIES[@]} -eq 0 ]; then
    return 0
  fi

  local entry announced=0
  for entry in "${DEPENDENCIES[@]}"; do
    parse_dep "$entry"
    if dep_present; then
      continue
    fi
    if [ "$announced" -eq 0 ]; then
      info "installing dependencies for $REPO_ID"
      announced=1
    fi
    # A dependency that will not install is worth a warning, not an abort:
    # the rest of the config is still worth putting in place.
    brew_install_dep || true
  done
  return 0
}

# --------------------------------------------------------------- stowing ----

# Build the stow flags shared by link and unlink. --no-folding keeps stow from
# symlinking whole directories, so several repos can contribute files to the
# same directory (~/.bash.d, ~/bin) without colliding.
stow_flags() {
  printf '%s\n' --no-folding
  [ "$DRY_RUN" -eq 1 ] && printf '%s\n' --simulate --verbose
  [ "$VERBOSE" -eq 1 ] && printf '%s\n' --verbose
  [ "$ADOPT" -eq 1 ] && printf '%s\n' --adopt
  return 0
}

run_stow() {
  local dir="$1" action="$2"
  shift 2
  local flags=()
  local f
  while IFS= read -r f; do
    [ -n "$f" ] && flags[${#flags[@]}]="$f"
  done <<EOF
$(stow_flags)
EOF

  stow --dir "$dir" --target "$TARGET" "$action" "${flags[@]}" "$@"
}

link_repo() {
  info "linking $REPO_ID ($REPO)"

  if [ ${#PACKAGES[@]} -eq 0 ]; then
    warn "no packages to link for $REPO_ID"
  else
    local pkg
    for pkg in "${PACKAGES[@]}"; do
      [ -d "$PACKAGES_PATH/$pkg" ] ||
        die "package '$pkg' listed in $REPO/dotfiles.conf but $PACKAGES_PATH/$pkg does not exist"
    done
    step "packages: ${PACKAGES[*]}"
    run_stow "$PACKAGES_PATH" --stow "${PACKAGES[@]}"
  fi

  if [ -d "$SECRETS_PATH/$SECRETS_PACKAGE" ]; then
    step "secrets: $SECRETS_PATH/$SECRETS_PACKAGE"
    run_stow "$SECRETS_PATH" --stow "$SECRETS_PACKAGE"
  elif [ -d "$TEMPLATES_PATH" ]; then
    warn "$REPO_ID has templates but no generated secrets yet; run: $PROGRAM secrets"
  fi
}

unlink_repo() {
  info "unlinking $REPO_ID ($REPO)"

  if [ ${#PACKAGES[@]} -gt 0 ]; then
    run_stow "$PACKAGES_PATH" --delete "${PACKAGES[@]}"
  fi

  if [ -d "$SECRETS_PATH/$SECRETS_PACKAGE" ]; then
    run_stow "$SECRETS_PATH" --delete "$SECRETS_PACKAGE"
  fi
}

# --------------------------------------------------------------- secrets ----

# Emit the templates to render, NUL-separated: every file under templates/
# unless TEMPLATES names a subset, as paths relative to templates/. That lets
# dotfiles.conf leave a secret off some hosts the same way it gates packages.
template_files() {
  if [ ${#TEMPLATES[@]} -eq 0 ]; then
    find "$TEMPLATES_PATH" -type f ! -name '.DS_Store' -print0
    return 0
  fi
  local t
  for t in "${TEMPLATES[@]}"; do
    printf '%s\0' "$TEMPLATES_PATH/$t"
  done
}

check_templates() {
  local t
  for t in ${TEMPLATES[@]+"${TEMPLATES[@]}"}; do
    [ -f "$TEMPLATES_PATH/$t" ] ||
      die "template '$t' listed in $REPO/dotfiles.conf but $TEMPLATES_PATH/$t does not exist"
  done
}

# Render the selected templates through `op inject` into a scratch dir,
# and only swap it into place once all of them succeeded. A half-rendered tree
# must never reach the state dir: stow symlinks point at it, and a partial
# swap would leave those links dangling.
secrets_repo() {
  if [ ! -d "$TEMPLATES_PATH" ]; then
    debug "$REPO_ID has no $TEMPLATES_DIR/, skipping"
    return 0
  fi

  info "rendering secrets for $REPO_ID"

  need_cmd rsync
  check_templates

  # Templates with no secret references are copied verbatim. `op inject` wants
  # an account even when it has nothing to resolve, and there is no reason to
  # make a repo that has not started using secrets yet sign in to 1Password.
  # The grep deliberately does not try to tell code from comments.
  # Secret references carry a vault but not an account. With more than one
  # account signed in, an unqualified reference silently resolves against
  # whichever one op considers default -- so pin it when the repo says to.
  local op_args=()
  if [ -n "$OP_ACCOUNT" ]; then
    op_args=(--account "$OP_ACCOUNT")
  fi

  local use_op=0
  if template_files | xargs -0 grep -qI 'op://' 2>/dev/null; then
    use_op=1
    need_cmd op
    op whoami ${op_args[@]+"${op_args[@]}"} >/dev/null 2>&1 ||
      die "1Password CLI is not signed in${OP_ACCOUNT:+ for account $OP_ACCOUNT}. Run: op signin${OP_ACCOUNT:+ --account $OP_ACCOUNT}"
  else
    debug "no op:// references under $TEMPLATES_PATH; copying templates verbatim"
  fi

  local dest="$SECRETS_PATH/$SECRETS_PACKAGE"
  local tmp
  tmp="$(mktemp -d "${TMPDIR:-/tmp}/dotfiles-inject.XXXXXX")"
  TMPDIRS="$TMPDIRS $tmp"

  local failed=0 count=0 ok tpl rel out
  while IFS= read -r -d '' tpl; do
    rel="${tpl#"$TEMPLATES_PATH/"}"
    out="$tmp/${rel%.tmpl}"
    mkdir -p "$(dirname "$out")"

    ok=1
    if [ "$use_op" -eq 1 ]; then
      # hostname and OP_VAULT are exported for the template's benefit: secret
      # references may interpolate them, which keeps one template usable
      # across machines and vaults.
      hostname="$HOST" OP_VAULT="$OP_VAULT" DOTFILES_HOST="$HOST" \
        op inject ${op_args[@]+"${op_args[@]}"} \
          --in-file "$tpl" --out-file "$out" >/dev/null || ok=0
    else
      cp "$tpl" "$out" || ok=0
    fi

    if [ "$ok" -eq 1 ]; then
      chmod 600 "$out"
      count=$((count + 1))
      step "$rel"
    else
      warn "could not render $rel"
      failed=1
    fi
  done < <(template_files)

  if [ "$failed" -ne 0 ]; then
    die "one or more templates failed to render; left $dest untouched"
  fi

  if [ "$count" -eq 0 ]; then
    warn "no templates found under $TEMPLATES_PATH"
    return 0
  fi

  if [ "$DRY_RUN" -eq 1 ]; then
    info "would install $count rendered file(s) into $dest"
    return 0
  fi

  mkdir -p "$dest"
  # --delete rather than rm -rf: files are replaced in place, so there is no
  # window where the tree is missing and the symlinks into it are dangling.
  rsync -a --delete "$tmp/" "$dest/"
  chmod 700 "$dest"
  info "installed $count rendered file(s) into $dest"
}

# ----------------------------------------------------------------- hooks ----

run_hook() {
  local hook="$REPO/hooks/$1"
  [ -x "$hook" ] || return 0
  info "running $1 hook for $REPO_ID"
  if [ "$DRY_RUN" -eq 1 ]; then
    step "would run $hook"
    return 0
  fi
  DOTFILES_REPO="$REPO" DOTFILES_TARGET="$TARGET" DOTFILES_HOST="$HOST" \
    OP_VAULT="$OP_VAULT" "$hook"
}

apply_repo() {
  ensure_deps_repo
  run_hook pre-install
  secrets_repo
  link_repo
  run_hook post-install
}

mark_installed() {
  if [ "$DRY_RUN" -eq 0 ] && [ ! -f "$INSTALLED_MARKER" ]; then
    mkdir -p "${INSTALLED_MARKER%/*}"
    : >"$INSTALLED_MARKER"
  fi
}

install_repo() {
  apply_repo
  baseline_migrations
  mark_installed
}

# ------------------------------------------------------------ migrations ----

# A migration is a markdown note in a repo's migrations/, named by its id. The
# engine only ever prints one and records that you said you had dealt with it.
MIGRATIONS_ACK_ALL=0
MIGRATIONS_ALL=0
MIGRATION_FOUND=0

migration_ids() {
  [ -d "$MIGRATIONS_PATH" ] || return 0
  find "$MIGRATIONS_PATH" -maxdepth 1 -type f -name '*.md' 2>/dev/null |
    sed -e 's|.*/||' -e 's|\.md$||' | sort
}

migration_applied() {
  [ -f "$MIGRATIONS_STATE" ] || return 1
  awk -F'\t' -v id="$1" '$1 == id { found = 1; exit } END { exit !found }' \
    "$MIGRATIONS_STATE"
}

migration_pending() {
  migration_ids | awk -v state="$MIGRATIONS_STATE" '
    BEGIN { while ((getline line < state) > 0) { split(line, f, "\t"); seen[f[1]] = 1 } }
    !($0 in seen)'
}

migration_when() {
  [ -f "$MIGRATIONS_STATE" ] || return 0
  awk -F'\t' -v id="$1" '$1 == id { print $2; exit }' "$MIGRATIONS_STATE"
}

migration_title() {
  local title
  title="$(sed -n '/^# /{s/^# *//p;q;}' "$MIGRATIONS_PATH/$1.md" 2>/dev/null || true)"
  printf '%s\n' "${title:-$1}"
}

migration_mark() {
  mkdir -p "${MIGRATIONS_STATE%/*}"
  printf '%s\t%s\n' "$1" "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" >>"$MIGRATIONS_STATE"
}

migration_render() {
  local rule='  ------------------------------------------------------------'
  printf '\n  %s%s%s\n' "$C_BOLD" "$1" "$C_RESET"
  printf '%s%s%s\n' "$C_DIM" "$rule" "$C_RESET"
  sed 's/^/  /' "$MIGRATIONS_PATH/$1.md"
  printf '%s%s%s\n' "$C_DIM" "$rule" "$C_RESET"
}

# A new machine has no older state to move away from, so it starts even.
baseline_migrations() {
  if [ ! -d "$MIGRATIONS_PATH" ] ||
     [ -f "$INSTALLED_MARKER" ] ||
     [ -f "$MIGRATIONS_STATE" ]; then
    return 0
  fi

  local id n=0
  while IFS= read -r id; do
    [ -n "$id" ] || continue
    [ "$DRY_RUN" -eq 1 ] || migration_mark "$id"
    n=$((n + 1))
  done <<EOF
$(migration_ids)
EOF
  local verb="baselined"
  [ "$DRY_RUN" -eq 0 ] || verb="would baseline"
  [ "$n" -eq 0 ] || step "$verb $n migration(s) as already applied"
}

migrations_repo() {
  local pending id reply count quit=0
  pending="$(migration_pending)"
  [ -n "$pending" ] || return 0

  count="$(printf '%s\n' "$pending" | wc -l | tr -d ' ')"
  info "$count pending migration(s) for $REPO_ID"

  while IFS= read -r id; do
    [ -n "$id" ] || continue
    [ "$quit" -eq 0 ] || break
    migration_render "$id"

    if [ "$DRY_RUN" -eq 1 ]; then
      continue
    fi
    if [ "$MIGRATIONS_ACK_ALL" -eq 1 ]; then
      migration_mark "$id"
      step "marked $id done"
      continue
    fi
    [ "$INTERACTIVE" -eq 1 ] || continue

    printf '  mark as done? [y/N/a/q] '
    reply=""
    read -r reply </dev/tty || true
    case "$reply" in
      y|Y) migration_mark "$id"; step "marked $id done" ;;
      a|A) MIGRATIONS_ACK_ALL=1; migration_mark "$id"; step "marked $id done" ;;
      q|Q) quit=1 ;;
    esac
  done <<EOF
$pending
EOF

  if [ "$INTERACTIVE" -eq 0 ] || [ "$quit" -eq 1 ]; then
    step "mark them done with: $PROGRAM migrations done <id>"
  fi
  [ "$quit" -eq 0 ] || return "$REPO_STOP"
  return 0
}

migrations_list_repo() {
  local ids id next width label color suffix when pending unapplied

  pending="$(migration_pending)"
  if [ "$MIGRATIONS_ALL" -eq 1 ]; then
    ids="$(migration_ids)"
  else
    ids="$pending"
  fi
  [ -n "$ids" ] || return 0

  next="${pending%%$'\n'*}"
  unapplied=$'\n'"$pending"$'\n'

  # Pad the id column to the widest one actually shown; they vary a lot.
  width="$(printf '%s\n' "$ids" |
    awk '{ if (length($0) > w) w = length($0) } END { print w + 0 }')"

  repo_header
  while IFS= read -r id; do
    [ -n "$id" ] || continue
    MIGRATION_FOUND=1

    suffix=""
    case "$unapplied" in
      *$'\n'"$id"$'\n'*)
        if [ "$id" = "$next" ]; then
          label="next"; color="$C_YELLOW$C_BOLD"
        else
          label="todo"; color="$C_DIM"
        fi
        ;;
      *)
        label="done"; color="$C_GREEN"
        when="$(migration_when "$id")"
        suffix="  $C_DIM(${when%%T*})$C_RESET"
        ;;
    esac

    printf '  %s%-4s%s  %-*s  %s%s\n' \
      "$color" "$label" "$C_RESET" "$width" "$id" "$(migration_title "$id")" "$suffix"
  done <<EOF
$ids
EOF
  printf '\n'
}

migrations_act_repo() {
  local action="$1" want="$2" id ids

  if [ -n "$want" ]; then
    [ -f "$MIGRATIONS_PATH/$want.md" ] || return 0
    ids="$want"
  else
    # Without --all only the first pending one anywhere is acted on.
    [ "$MIGRATIONS_ALL" -eq 1 ] || [ "$MIGRATION_FOUND" -eq 0 ] || return 0
    ids="$(migration_pending)"
    [ -n "$ids" ] || return 0
    [ "$MIGRATIONS_ALL" -eq 1 ] || ids="${ids%%$'\n'*}"
  fi

  while IFS= read -r id; do
    [ -n "$id" ] || continue
    MIGRATION_FOUND=1
    if [ "$action" = show ]; then
      repo_header
      migration_render "$id"
    elif migration_applied "$id"; then
      step "$REPO_ID: $id was already done"
    else
      migration_mark "$id"
      step "$REPO_ID: marked $id done"
    fi
  done <<EOF
$ids
EOF
  return 0
}

slugify() {
  printf '%s' "$1" |
    tr '[:upper:]' '[:lower:]' |
    sed -e 's/[^a-z0-9]\{1,\}/-/g' -e 's/^-//' -e 's/-$//'
}

# Creates the note in the first repo it is handed, so --repo picks the repo
# and the bare form takes the first configured one.
migrations_new_repo() {
  local slug="$1" id file title editor
  id="$(date '+%Y%m%d')-$slug"
  file="$MIGRATIONS_PATH/$id.md"
  if [ -e "$file" ]; then
    die "already exists: $file"
  fi

  if [ "$DRY_RUN" -eq 1 ]; then
    info "would create $file"
    return "$REPO_STOP"
  fi

  title="$(printf '%s' "$slug" | tr '-' ' ' |
    awk '{ print toupper(substr($0, 1, 1)) substr($0, 2) }')"

  mkdir -p "$MIGRATIONS_PATH"
  cat >"$file" <<TEMPLATE
# $title

Why this is needed, in a sentence or two.

    the command to run
TEMPLATE

  info "created $file"
  step "mark it done here with: $PROGRAM migrations done $id"

  editor="${VISUAL:-${EDITOR:-}}"
  if [ "$INTERACTIVE" -eq 1 ] && [ -n "$editor" ]; then
    # Unquoted so EDITOR can carry flags, e.g. "code -w".
    # shellcheck disable=SC2086
    $editor "$file" </dev/tty >/dev/tty 2>&1 || warn "editor exited non-zero"
  fi
  return "$REPO_STOP"
}

migrations_list() {
  for_each_repo migrations_list_repo
  [ "$MIGRATION_FOUND" -eq 1 ] || info "no pending migrations"
}

cmd_migrations() {
  local sub="${1:-list}" want slug

  case "$sub" in
    list)
      migrations_list
      ;;
    'done'|show)
      want="${2:-}"
      if [ "$sub" = show ] && [ "$MIGRATIONS_ALL" -eq 1 ] && [ -z "$want" ]; then
        migrations_list
        return 0
      fi
      for_each_repo migrations_act_repo "$sub" "$want"
      if [ "$MIGRATION_FOUND" -eq 0 ]; then
        [ -z "$want" ] || die "no such migration: $want"
        info "no pending migrations"
      fi
      ;;
    new)
      slug="$(slugify "${2:-}")"
      [ -n "$slug" ] || die "usage: $PROGRAM migrations new <slug>"
      for_each_repo migrations_new_repo "$slug"
      ;;
    *)
      die "unknown migrations subcommand: $sub"
      ;;
  esac
}

# ---------------------------------------------------------------- update ----

update_git_repo() {
  if [ ! -d "$REPO/.git" ]; then
    warn "$REPO_ID is not a git checkout; nothing to pull"
    return 0
  fi

  local dirty ahead
  dirty="$(git -C "$REPO" status --porcelain 2>/dev/null || true)"
  [ -z "$dirty" ] ||
    warn "$REPO_ID has uncommitted changes; --autostash will carry them across"

  if [ "$DRY_RUN" -eq 1 ]; then
    step "would git pull --rebase"
  else
    step "git pull --rebase"
    if ! git -C "$REPO" pull --rebase --autostash; then
      warn "pull failed for $REPO_ID; sort it out and run '$PROGRAM update' again"
      return 1
    fi
  fi

  ahead="$(git -C "$REPO" rev-list --count '@{upstream}..HEAD' 2>/dev/null || echo 0)"
  [ "${ahead:-0}" = 0 ] ||
    warn "$REPO_ID has $ahead unpushed commit(s); run: git -C $REPO push"
  return 0
}

# Accumulated by update_repo: a repo that cannot be pulled is skipped rather
# than fatal, but `update` must not then claim success.
UPDATE_RC=0

update_repo() {
  info "updating $REPO_ID ($REPO)"
  if ! update_git_repo; then
    UPDATE_RC=1
    return 0
  fi
  apply_repo
  mark_installed
  migrations_repo
}

cmd_update() {
  need_cmd stow
  need_cmd git
  for_each_repo update_repo
  if [ "$UPDATE_RC" -ne 0 ]; then
    warn "some repos were not updated"
    return 1
  fi
  info "done"
}

# ---------------------------------------------------------------- status ----

abspath() {
  printf '%s/%s\n' "$(cd "$(dirname "$1")" && pwd -P)" "$(basename "$1")"
}

# True when $1 is a symlink resolving to the file $2.
points_at() {
  local link="$1" want="$2" target abs
  [ -L "$link" ] || return 1
  target="$(readlink "$link")"
  case "$target" in
    /*) abs="$target" ;;
    *)  abs="$(dirname "$link")/$target" ;;
  esac
  [ -e "$abs" ] || return 1
  [ "$(abspath "$abs")" = "$(abspath "$want")" ]
}

# Print one "name  linked/total" line for the stow package rooted at $2.
status_package() {
  local name="$1" root="$2"
  local linked=0 total=0 src rel dst color
  while IFS= read -r -d '' src; do
    total=$((total + 1))
    rel="${src#"$root/"}"
    dst="$TARGET/$rel"
    if points_at "$dst" "$src"; then
      linked=$((linked + 1))
    fi
  done < <(find "$root" -type f -print0 2>/dev/null)

  if [ "$total" -gt 0 ] && [ "$linked" -eq "$total" ]; then
    color="$C_GREEN"
  else
    color="$C_YELLOW"
  fi
  printf '  %-14s %s%d/%d linked%s' "$name" "$color" "$linked" "$total" "$C_RESET"
}

status_repo() {
  printf '%s%s%s  %s\n' "$C_BOLD" "$REPO_ID" "$C_RESET" "$REPO"

  local pkg
  for pkg in ${PACKAGES[@]+"${PACKAGES[@]}"}; do
    status_package "$pkg" "$PACKAGES_PATH/$pkg"
    printf '\n'
  done

  # The rendered secrets are a package too, so report them the same way.
  if [ -d "$TEMPLATES_PATH" ]; then
    local n
    n="$(template_files | tr -dc '\0' | wc -c | tr -d ' ')"
    if [ -d "$SECRETS_PATH/$SECRETS_PACKAGE" ]; then
      status_package "secrets" "$SECRETS_PATH/$SECRETS_PACKAGE"
      printf '  (%s template(s), rendered into %s)\n' "$n" "$SECRETS_PATH/$SECRETS_PACKAGE"
    else
      printf '  %-14s %s template(s), %snot yet rendered%s\n' "secrets" "$n" "$C_YELLOW" "$C_RESET"
    fi
  fi
  printf '\n'
}

# ---------------------------------------------------------------- doctor ----

DOCTOR_INSTALL=0

check_cmd() {
  local cmd="$1" kind="$2" pkg="$3"
  DEP_CMD="$cmd"; DEP_KIND="$kind"; DEP_PKG="$pkg"

  if dep_present; then
    printf '  %s%-6s%s %-16s %s\n' "$C_GREEN" ok "$C_RESET" "$cmd" \
      "$(command -v "$cmd" 2>/dev/null || echo "cask $pkg installed")"
    return 0
  fi

  if [ "$DOCTOR_INSTALL" -eq 1 ] && command -v brew >/dev/null 2>&1; then
    printf '  %s%-6s%s %-16s installing via brew\n' "$C_YELLOW" ".." "$C_RESET" "$cmd"
    if [ "$kind" = cask ]; then
      brew install --cask "$pkg"
    else
      brew install "$pkg"
    fi
    return 0
  fi

  if [ "$kind" = cask ]; then
    printf '  %s%-6s%s %-16s brew install --cask %s\n' "$C_RED" miss "$C_RESET" "$cmd" "$pkg"
  else
    printf '  %s%-6s%s %-16s brew install %s\n' "$C_RED" miss "$C_RESET" "$cmd" "$pkg"
  fi
  return 1
}

# Accumulated rather than returned: a failing repo must not stop the others
# from being checked.
DOCTOR_RC=0

doctor_deps_repo() {
  if [ ${#DEPENDENCIES[@]} -eq 0 ]; then
    return 0
  fi

  info "dependencies for $REPO_ID"
  local entry
  for entry in "${DEPENDENCIES[@]}"; do
    parse_dep "$entry"
    check_cmd "$DEP_CMD" "$DEP_KIND" "$DEP_PKG" || DOCTOR_RC=1
  done
  return 0
}

cmd_doctor() {
  local rc=0
  DOCTOR_RC=0

  info "engine dependencies"
  check_cmd stow formula stow || rc=1
  check_cmd op cask 1password-cli || rc=1
  check_cmd rsync formula rsync || rc=1
  check_cmd git formula git || rc=1

  info "1Password"
  if command -v op >/dev/null 2>&1; then
    if op whoami >/dev/null 2>&1; then
      printf '  %s%-6s%s signed in as %s\n' "$C_GREEN" ok "$C_RESET" "$(op whoami --format json 2>/dev/null | sed -n 's/.*"email": *"\([^"]*\)".*/\1/p' | head -1)"
    else
      printf '  %s%-6s%s not signed in; run: op signin\n' "$C_RED" miss "$C_RESET"
      rc=1
    fi
  fi

  info "config"
  if [ -n "${DOTFILES_REPOS:-}" ]; then
    printf '  %s%-6s%s DOTFILES_REPOS=%s\n' "$C_GREEN" ok "$C_RESET" "$DOTFILES_REPOS"
  fi
  if [ -f "$CONFIG_FILE" ] || [ -n "${DOTFILES_REPOS:-}" ]; then
    [ -n "${DOTFILES_REPOS:-}" ] ||
      printf '  %s%-6s%s %s\n' "$C_GREEN" ok "$C_RESET" "$CONFIG_FILE"
    local repo
    while IFS= read -r repo; do
      [ -n "$repo" ] || continue
      if [ -d "$repo" ]; then
        if [ -f "$repo/dotfiles.conf" ]; then
          printf '  %s%-6s%s %s\n' "$C_GREEN" ok "$C_RESET" "$repo"
        else
          printf '  %s%-6s%s %s (no dotfiles.conf)\n' "$C_YELLOW" warn "$C_RESET" "$repo"
        fi
      else
        printf '  %s%-6s%s %s (not found)\n' "$C_RED" miss "$C_RESET" "$repo"
        rc=1
      fi
    done <<EOF
$(repo_list 2>/dev/null || true)
EOF
  else
    printf '  %s%-6s%s %s does not exist\n' "$C_RED" miss "$C_RESET" "$CONFIG_FILE"
    rc=1
  fi

  # Whatever the config repos declare for themselves, on top of the engine's
  # own requirements above.
  if [ -f "$CONFIG_FILE" ] || [ -n "${DOTFILES_REPOS:-}" ]; then
    for_each_repo doctor_deps_repo
    [ "$DOCTOR_RC" -eq 0 ] || rc=1
  fi

  return $rc
}

# ------------------------------------------------------------------ main ----

usage() {
  cat <<EOF
$PROGRAM $VERSION -- link config repos into \$HOME with stow + 1Password

usage: $PROGRAM <command> [options]

commands:
  install     install declared dependencies, render secrets, link, run hooks
  update      pull each repo, re-apply it, then show any pending migrations
  migrations  list pending migrations; also \`new <slug>\`, \`done [id]\`, \`show [id]\`
              \`--all\` on either listing shows the whole timeline
  link        stow the packages of every configured repo
  unlink      unstow them again
  secrets     render templates/ through \`op inject\` only
  status      show what is configured and what is currently linked
  doctor      check dependencies (engine's and each repo's) and configuration
  help        this message

options:
  -n, --dry-run   show what would happen, change nothing
  -v, --verbose   pass --verbose to stow, print more
      --adopt     stow --adopt: pull existing files into the repo (link only)
      --install   doctor only: brew install anything missing
      --all       migrations only: list applied too, or mark every one done
      --repo ID   act on only this config repo

environment:
  DOTFILES_CONFIG   config file (default $CONFIG_FILE)
  DOTFILES_STATE    state dir for secrets and migration state (default $STATE_DIR)
  DOTFILES_REPOS    colon-separated repo list, overrides the config file
EOF
}

main() {
  local cmd="${1:-help}"
  [ $# -gt 0 ] && shift || true

  local ARGS=()
  while [ $# -gt 0 ]; do
    case "$1" in
      -n|--dry-run) DRY_RUN=1 ;;
      -v|--verbose) VERBOSE=1 ;;
      --adopt)      ADOPT=1 ;;
      --install)    DOCTOR_INSTALL=1 ;;
      --all)        MIGRATIONS_ALL=1 ;;
      --repo)       ONLY_REPO="${2:-}"
                    [ -n "$ONLY_REPO" ] || die "--repo needs a repo id"
                    shift ;;
      -h|--help)    usage; return 0 ;;
      -*)           die "unknown option: $1" ;;
      *)            ARGS[${#ARGS[@]}]="$1" ;;
    esac
    shift
  done

  case "$cmd" in
    install)  need_cmd stow; for_each_repo install_repo; info "done" ;;
    update)   cmd_update ;;
    migrations) cmd_migrations ${ARGS[@]+"${ARGS[@]}"} ;;
    link)     need_cmd stow; for_each_repo link_repo; info "done" ;;
    unlink)   need_cmd stow; for_each_repo unlink_repo; info "done" ;;
    secrets)  for_each_repo secrets_repo; info "done" ;;
    status)   for_each_repo status_repo ;;
    doctor)   cmd_doctor ;;
    version|--version) printf '%s %s\n' "$PROGRAM" "$VERSION" ;;
    help|--help|-h) usage ;;
    *)        usage >&2; die "unknown command: $cmd" ;;
  esac
}

main "$@"
